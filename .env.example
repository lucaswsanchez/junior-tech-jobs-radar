# PostgreSQL connection string (Supabase "Session pooler" URL in production).
# If unset, the pipeline uses a local SQLite file at data/jobs.db.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobs_radar

# Seconds to wait between HTTP requests to the same source (be polite).
REQUEST_DELAY_SECONDS=1.0

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
